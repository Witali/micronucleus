# Assembly settings only; Makefile.inc must retain Makefile whitespace rules.
[*.{S,s,asm}]
indent_style = space
indent_size = 4
tab_width = 4
end_of_line = lf
insert_final_newline = true

[experimental/attiny88/{compact,block64}/source/*.inc]
indent_style = space
indent_size = 4
tab_width = 4
end_of_line = lf
insert_final_newline = true
